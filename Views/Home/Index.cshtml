@model List<FlowDesk.Models.Menus>
@{
    ViewBag.Title = "首页";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // 根目录：ParentId=0 且 MenuType=1(目录)
    var roots = Model
        .Where(x => x.ParentId == 0 && x.MenuType == (byte)1)
        .OrderBy(x => x.Sort)
        .ThenBy(x => x.Id)
        .ToList();
}

<div class="layui-layout layui-layout-admin">

    <div class="layui-header">
        <div class="layui-logo layui-hide-xs layui-bg-black">FlowDesk</div>

        
        <ul class="layui-nav layui-layout-left">
            <li class="layui-nav-item layui-show-xs-inline-block layui-hide-sm" lay-header-event="menuLeft">
                <i class="layui-icon layui-icon-spread-left"></i>
            </li>
            <li class="layui-nav-item layui-hide-xs">
                <a href="javascript:;" class="menu-link" data-url="/Home/Dashboard">仪表盘</a>
            </li>
        </ul>

        <ul class="layui-nav layui-layout-right">
            <li class="layui-nav-item layui-hide layui-show-sm-inline-block">
                <a href="javascript:;">
                    <img src="//unpkg.com/outeres@0.0.10/img/layui/icon-v2.png" class="layui-nav-img">
                    @ViewBag.LoginUser
                </a>
                <dl class="layui-nav-child">
                    <dd><a href="javascript:;" onclick="GetPersonalInformation()">个人信息管理</a></dd>
                    <dd><a href="javascript:;" onclick="ChangePassword()">密码管理</a></dd>
                    <dd><a href="javascript:;" onclick="SignOut()">退出</a></dd>
                </dl>
            </li>

            <li class="layui-nav-item" lay-header-event="menuRight" lay-unselect>
                <a href="javascript:;">
                    <i class="layui-icon layui-icon-more-vertical"></i>
                </a>
            </li>
        </ul>
    </div>

    <div class="layui-side layui-bg-black">
        <div class="layui-side-scroll">

            <!-- 左侧导航（动态：两级） -->
            <ul class="layui-nav layui-nav-tree" lay-filter="leftMenu" id="leftMenu">


                @* 目录 -> 菜单 *@
                @foreach (var root in roots)
                {
                    var children = Model
                        .Where(x => x.ParentId == root.Id && x.MenuType == (byte)2)
                        .OrderBy(x => x.Sort)
                        .ThenBy(x => x.Id)
                        .ToList();

                    <li class="layui-nav-item layui-nav-itemed">
                        <a href="javascript:;">
                            @if (!string.IsNullOrWhiteSpace(root.Icon))
                            {
                                <i class="layui-icon @root.Icon"></i>
                            }
                            @root.Name
                        </a>

                        <dl class="layui-nav-child">
                            @foreach (var child in children)
                            {
                                <dd>
                                    <a href="javascript:;" class="menu-link" data-url="@child.Url">
                                        @if (!string.IsNullOrWhiteSpace(child.Icon))
                                        {
                                            <i class="layui-icon @child.Icon"></i>
                                        }
                                        @child.Name
                                    </a>
                                </dd>
                            }
                        </dl>
                    </li>
                }
            </ul>

        </div>
    </div>

    <div class="layui-body">
        <!-- 内容主体区域：用 iframe（推荐） -->
        <iframe id="mainFrame"
                src="/Home/Dashboard"
                frameborder="0"
                style="width:100%;height: calc(100vh - 110px);">
        </iframe>
    </div>

    <div class="layui-footer">
        FlowDesk © @DateTime.Now.Year
    </div>
</div>

<script>
    // 全局缓存（保证在函数里可用）
    var element, layer, util, $;

    layui.use(['element', 'layer', 'util'], function () {
        element = layui.element;
        layer = layui.layer;
        util = layui.util;
        $ = layui.$;

        // 渲染导航
        element.render('nav', 'leftMenu');

        // 头部事件
        util.event('lay-header-event', {
            menuLeft: function () {
                layer.msg('展开左侧菜单的操作', { icon: 0 });
            },
            menuRight: function () {
                layer.open({
                    type: 1,
                    title: '更多',
                    content: '<div style="padding: 15px;">处理右侧面板的操作</div>',
                    area: ['260px', '100%'],
                    offset: 'rt',
                    anim: 'slideLeft',
                    shadeClose: true,
                    scrollbar: false
                });
            }
        });

        // 点击菜单 -> 统一走 openPage（自动高亮）
        $(document).on('click', '.menu-link', function () {
            var url = $(this).data('url');
            openPage(url);
        });

        // 如果 fresh=1（刚登录），强制进 Dashboard，并清理历史
        var qs = new URLSearchParams(window.location.search);
        var fresh = qs.get('fresh');

        if (fresh === '1') {
            localStorage.removeItem('FLOWDESK_LAST_URL');
            openPage('/Home/Dashboard');

            // 可选：去掉地址栏参数，避免刷新重复清理
            history.replaceState(null, '', '/Home/Index');
        } else {
            var last = localStorage.getItem('FLOWDESK_LAST_URL');
            if (last) openPage(last);
            else openPage('/Home/Dashboard');
        }
    });

    // 设置左侧菜单选中
    function setActiveMenu(url) {
        if (!url) return;

        // 清理之前状态
        $('#leftMenu a').removeClass('layui-this');
        $('#leftMenu dd').removeClass('layui-this');
        $('#leftMenu li').removeClass('layui-nav-itemed');

        // 找到对应链接
        var $a = $('#leftMenu a.menu-link[data-url="' + url + '"]');
        if ($a.length === 0) return;

        // 设置选中 + 展开父级
        $a.addClass('layui-this');
        $a.closest('dd').addClass('layui-this');
        $a.closest('li.layui-nav-item').addClass('layui-nav-itemed');

        // 重新渲染 nav
        if (element) element.render('nav', 'leftMenu');
    }

    // 打开页面并高亮菜单（给 iframe 页面调用：window.parent.openPage(url)）
    function openPage(url) {
        if (!url) return;
        $('#mainFrame').attr('src', url);
        setActiveMenu(url);
        localStorage.setItem('FLOWDESK_LAST_URL', url);
    }

    // 退出登录
    function SignOut() {
        // 注意：这里用全局 layer/$（已在 layui.use 中初始化）
        layui.layer.confirm('确定要退出登录吗？', { icon: 3, title: '退出确认' }, function (index) {
            layui.layer.close(index);

            $.ajax({
                url: "/Home/SignOut",
                type: "post",
                success: function (res) {
                    if (res.code == 0) {
                        localStorage.removeItem('FLOWDESK_LAST_URL');
                        layui.layer.msg('退出成功', { icon: 1, time: 800 }, function () {
                            window.location.href = "/Login/LoginIndex";
                        });
                    } else {
                        layui.layer.msg(res.msg || res.message || '退出失败', { icon: 5 });
                    }
                },
                error: function () {
                    layui.layer.msg('网络错误，退出失败', { icon: 5 });
                }
            });
        });
    }

    // 展示个人信息
    function GetPersonalInformation() {
        layui.use(['layer'], function () {
            layui.layer.open({
                type: 2,
                area: ['520px', '480px'],
                title: '个人信息',
                shade: 0.6,
                shadeClose: true,
                maxmin: true,
                anim: 0,
                content: '/Home/ViewPersonalInfo'
            });
        });
    }

    // 密码管理
    function ChangePassword() {
        layui.use(['layer'], function () {
            layui.layer.open({
                type: 2,
                area: ['520px', '480px'],
                title: '密码管理',
                shade: 0.6,
                shadeClose: true,
                maxmin: true,
                anim: 0,
                content: '/Home/ChangePasswordView'
            });
        });
    }
</script>

