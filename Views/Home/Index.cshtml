@model List<FlowDesk.Models.Menus>
@{
    ViewBag.Title = "首页";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // 根目录：ParentId=0 且 MenuType=1(目录)
    var roots = Model
        .Where(x => x.ParentId == 0 && x.MenuType == (byte)1)
        .OrderBy(x => x.Sort)
        .ThenBy(x => x.Id)
        .ToList();
}

<div class="layui-layout layui-layout-admin">

    <div class="layui-header">
        <div class="layui-logo layui-hide-xs layui-bg-black">FlowDesk</div>

        <
        <ul class="layui-nav layui-layout-left">
            <li class="layui-nav-item layui-show-xs-inline-block layui-hide-sm" lay-header-event="menuLeft">
                <i class="layui-icon layui-icon-spread-left"></i>
            </li>
            <li class="layui-nav-item layui-hide-xs"><a href="javascript:;" class="menu-link" data-url="/Home/Welcome">Dashboard</a></li>
        </ul>

        <ul class="layui-nav layui-layout-right">
            <li class="layui-nav-item layui-hide layui-show-sm-inline-block">
                <a href="javascript:;">
                    <img src="//unpkg.com/outeres@0.0.10/img/layui/icon-v2.png" class="layui-nav-img">
                    @ViewBag.LoginUser
                </a>
                <dl class="layui-nav-child">
                    <dd><a href="javascript:;" onclick="GetPersonalInformation()">个人信息管理</a></dd>
                    <dd><a href="javascript:;" onclick="ChangePassword()">密码管理</a></dd>
                    <dd><a href="javascript:;" onclick="SignOut()">退出</a></dd>
                </dl>
            </li>

            <li class="layui-nav-item" lay-header-event="menuRight" lay-unselect>
                <a href="javascript:;">
                    <i class="layui-icon layui-icon-more-vertical"></i>
                </a>
            </li>
        </ul>
    </div>

    <div class="layui-side layui-bg-black">
        <div class="layui-side-scroll">

            <!-- 左侧导航（动态：两级） -->
            <ul class="layui-nav layui-nav-tree" lay-filter="leftMenu" id="leftMenu">


                @* 目录 -> 菜单 *@
                @foreach (var root in roots)
                {
                    var children = Model
                        .Where(x => x.ParentId == root.Id && x.MenuType == (byte)2)
                        .OrderBy(x => x.Sort)
                        .ThenBy(x => x.Id)
                        .ToList();

                    <li class="layui-nav-item layui-nav-itemed">
                        <a href="javascript:;">
                            @if (!string.IsNullOrWhiteSpace(root.Icon))
                            {
                                <i class="layui-icon @root.Icon"></i>
                            }
                            @root.Name
                        </a>

                        <dl class="layui-nav-child">
                            @foreach (var child in children)
                            {
                                <dd>
                                    <a href="javascript:;" class="menu-link" data-url="@child.Url">
                                        @if (!string.IsNullOrWhiteSpace(child.Icon))
                                        {
                                            <i class="layui-icon @child.Icon"></i>
                                        }
                                        @child.Name
                                    </a>
                                </dd>
                            }
                        </dl>
                    </li>
                }
            </ul>

        </div>
    </div>

    <div class="layui-body">
        <!-- 内容主体区域：用 iframe（推荐） -->
        <iframe id="mainFrame"
                src="/Home/Welcome"
                frameborder="0"
                style="width:100%;height: calc(100vh - 110px);">
        </iframe>
    </div>

    <div class="layui-footer">
        FlowDesk © @DateTime.Now.Year
    </div>
</div>

<script>
    layui.use(['element', 'layer', 'util'], function () {
        var element = layui.element;
        var layer = layui.layer;
        var util = layui.util;
        var $ = layui.$;

        // 让 Layui 重新渲染导航
        element.render('nav', 'leftMenu');

        // 点击菜单 -> iframe 跳转
        $(document).on('click', '.menu-link', function () {
            var url = $(this).data('url');
            if (!url) return;
            $('#mainFrame').attr('src', url);
        });

        // 头部事件
        util.event('lay-header-event', {
            menuLeft: function () {
                layer.msg('展开左侧菜单的操作', { icon: 0 });
            },
            menuRight: function () {
                layer.open({
                    type: 1,
                    title: '更多',
                    content: '<div style="padding: 15px;">处理右侧面板的操作</div>',
                    area: ['260px', '100%'],
                    offset: 'rt',
                    anim: 'slideLeft',
                    shadeClose: true,
                    scrollbar: false
                });
            }
        });

    });

    // 退出登录
    function SignOut() {
        layui.layer.confirm('确定要退出登录吗？', { icon: 3, title: '退出确认' }, function (index) {
            layui.layer.close(index);

            $.ajax({
                url: "/Home/SignOut",
                type: "post",
                success: function (res) {
                    if (res.code == 0) {
                        layui.layer.msg('退出成功', { icon: 1, time: 800 }, function () {
                            window.location.href = "/Login/LoginIndex";
                        });
                    } else {
                        layui.layer.msg(res.msg || res.message || '退出失败', { icon: 5 });
                    }
                },
                error: function () {
                    layui.layer.msg('网络错误，退出失败', { icon: 5 });
                }
            });
        });
    }

    //展示个人信息
    function GetPersonalInformation() {
        layer.open({
            type: 2, // page 层类型
            area: ['520px', '480px'],
            title:'个人信息',
            shade: 0.6, // 遮罩透明度
            shadeClose: true, // 点击遮罩区域，关闭弹层
            maxmin: true, // 允许全屏最小化
            anim: 0, // 0-6 的动画形式，-1 不开启
            content: '/Home/ViewPersonalInfo'
        });
    }

    //密码管理
    function ChangePassword() {
        layer.open({
            type: 2, // page 层类型
            area: ['520px', '480px'],
            title: '密码管理',
            shade: 0.6, // 遮罩透明度
            shadeClose: true, // 点击遮罩区域，关闭弹层
            maxmin: true, // 允许全屏最小化
            anim: 0, // 0-6 的动画形式，-1 不开启
            content: '/Home/ChangePasswordView'
        });
    }
</script>