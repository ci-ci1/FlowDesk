@{
    ViewBag.Title = "个人信息";
}

<style>
    :root {
        --bg1: #0b1220;
        --bg2: #0a2a43;
        --card: #0f1b2d;
        --text: #e8eef7;
        --muted: #9fb2c8;
        --line: rgba(255,255,255,.10);
        --primary: #3b82f6;
        --primary2: #60a5fa;
        --danger: #ef4444;
        --shadow: 0 20px 60px rgba(0,0,0,.45);
        --radius: 12px;
        font-family: ui-sans-serif, system-ui, -apple-system, "PingFang SC","Microsoft YaHei", Arial;
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        background: linear-gradient(180deg, var(--bg1), var(--bg2));
        color: var(--text);
        padding: 24px;
        min-height: 100vh;
    }

    .info-container {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .info-header {
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--line);
    }

    .info-title {
        font-size: 18px;
        font-weight: 600;
        margin: 0;
    }

    .info-body {
        flex: 1;
        overflow-y: auto;
    }

    .info-list {
        display: grid;
        grid-template-columns: 100px 1fr;
        gap: 12px 16px;
        align-items: center;
    }

    .info-label {
        color: var(--muted);
        font-size: 13px;
        text-align: right;
    }

    .info-value {
        color: var(--text);
        font-size: 14px;
        line-height: 1.5;
        word-break: break-all;
    }

        .info-value.null {
            color: rgba(255,255,255,.3);
            font-style: italic;
        }

    /* 可编辑输入框样式 */
    .info-input {
        width: 100%;
        padding: 6px 10px;
        background: rgba(255,255,255,.06);
        border: 1px solid var(--line);
        border-radius: 8px;
        color: var(--text);
        font-size: 14px;
        outline: none;
        transition: border .2s;
    }

        .info-input:focus {
            border-color: var(--primary);
            background: rgba(255,255,255,.08);
        }

        .info-input::placeholder {
            color: rgba(255,255,255,.3);
        }

    .info-footer {
        margin-top: 20px;
        padding-top: 12px;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .btn {
        padding: 6px 14px;
        border: 0;
        border-radius: 8px;
        font-size: 13px;
        cursor: pointer;
        transition: all .2s;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--primary), var(--primary2));
        color: white;
    }

    .btn-default {
        background: rgba(255,255,255,.06);
        color: var(--text);
        border: 1px solid var(--line);
    }

    .btn-danger {
        background: rgba(239,68,68,.15);
        color: #f87171;
        border: 1px solid rgba(239,68,68,.2);
    }

    .btn:hover {
        filter: brightness(1.1);
    }

    /* 滚动条样式 */
    ::-webkit-scrollbar {
        width: 6px;
    }

    ::-webkit-scrollbar-track {
        background: rgba(255,255,255,.04);
        border-radius: 3px;
    }

    ::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,.15);
        border-radius: 3px;
    }

        ::-webkit-scrollbar-thumb:hover {
            background: rgba(255,255,255,.25);
        }
</style>

<div class="info-container">
    <div class="info-header">
        <h3 class="info-title">个人信息</h3>
    </div>

    <div class="info-body">
        <div class="info-list">
            <!-- 用户ID（不显示） -->
            <input type="hidden" name="Id" value="@ViewBag.Id">


            <!-- 用户名（不可编辑） -->
            <div class="info-label">用户名：</div>
            <div class="info-value" id="username">@ViewBag.UserName</div>

            <!-- 真实姓名（可编辑） -->
            <div class="info-label">真实姓名：</div>
            <div class="info-value" id="realNameContainer">
                <span id="realNameText">@ViewBag.RealName</span>
                <input type="text" class="info-input" id="realNameInput" value="@ViewBag.RealName" style="display: none;">
            </div>

            <!-- 邮箱（可编辑） -->
            <div class="info-label">邮箱：</div>
            <div class="info-value @(ViewBag.Email == null ? "null" : "")" id="emailContainer">
                <span id="emailText">@(ViewBag.Email ?? "未填写")</span>
                <input type="email" class="info-input" id="emailInput" value="@(ViewBag.Email ?? "")" placeholder="请输入邮箱" style="display: none;">
            </div>

            <!-- 手机号（可编辑） -->
            <div class="info-label">手机号：</div>
            <div class="info-value @(ViewBag.Phone == null ? "null" : "")" id="phoneContainer">
                <span id="phoneText">@(ViewBag.Phone ?? "未填写")</span>
                <input type="tel" class="info-input" id="phoneInput" value="@(ViewBag.Phone ?? "")" placeholder="请输入手机号" style="display: none;">
            </div>

            <!-- 账号状态（不可编辑） -->
            <div class="info-label">账号状态：</div>
            <div class="info-value" id="status">@(ViewBag.Status == 1 ? "正常" : "禁用")</div>

            <!-- 创建时间（不可编辑） -->
            <div class="info-label">创建时间：</div>
            <div class="info-value" id="createdAt">@ViewBag.CreatedAt</div>

            <!-- 更新时间（不可编辑） -->
            <div class="info-label">更新时间：</div>
            <div class="info-value" id="updatedAt">@ViewBag.UpdatedAt</div>
        </div>
    </div>

    <div class="info-footer">
        <button class="btn btn-default" onclick="parent.layer.closeAll()">关闭</button>
        <button class="btn btn-primary" id="editBtn">修改信息</button>
        <button class="btn btn-primary" id="saveBtn" style="display: none;">保存修改</button>
        <button class="btn btn-danger" id="cancelBtn" style="display: none;">取消编辑</button>
    </div>
</div>


<script>
    layui.use(['layer'], function () {
        var layer = layui.layer;
        var isEditing = false; // 编辑状态标记

        // 存储原始数据（用于取消编辑时恢复）
        var originalData = {
            realName: $('#realNameText').text(),
            email: $('#emailText').text() === '未填写' ? '' : $('#emailText').text(),
            phone: $('#phoneText').text() === '未填写' ? '' : $('#phoneText').text()
        };

        // 修改信息按钮 - 切换到编辑状态
        $('#editBtn').click(function () {
            if (isEditing) return;

            // 切换按钮显示状态
            $('#editBtn').hide();
            $('#saveBtn').show();
            $('#cancelBtn').show();

            // 切换字段为可编辑状态
            $('#realNameText').hide();
            $('#realNameInput').show();

            $('#emailText').hide();
            $('#emailInput').show();

            $('#phoneText').hide();
            $('#phoneInput').show();

            isEditing = true;
        });

        // 取消编辑 - 恢复为查看状态
        $('#cancelBtn').click(function () {
            if (!isEditing) return;

            // 恢复原始数据
            $('#realNameInput').val(originalData.realName);
            $('#emailInput').val(originalData.email);
            $('#phoneInput').val(originalData.phone);

            // 切换按钮显示状态
            $('#saveBtn').hide();
            $('#cancelBtn').hide();
            $('#editBtn').show();

            // 切换字段为查看状态
            $('#realNameInput').hide();
            $('#realNameText').text(originalData.realName).show();

            $('#emailInput').hide();
            $('#emailText').text(originalData.email || '未填写').show();
            if (originalData.email) $('#emailText').removeClass('null');
            else $('#emailText').addClass('null');

            $('#phoneInput').hide();
            $('#phoneText').text(originalData.phone || '未填写').show();
            if (originalData.phone) $('#phoneText').removeClass('null');
            else $('#phoneText').addClass('null');

            isEditing = false;
        });

        // 保存修改按钮
        $('#saveBtn').click(function () {
            if (!isEditing) return;

            // 获取编辑后的数据
            var newData = {
                Id: $('input[name="Id"]').val(),
                realName: $('#realNameInput').val().trim(),
                email: $('#emailInput').val().trim(),
                phone: $('#phoneInput').val().trim(),
                userName: $('#username').text() // 用户名作为标识
            };

            // 真实姓名必填
            if (!newData.realName) {
                layer.msg('真实姓名不能为空，请填写', { icon: 5 });
                $('#realNameInput').focus();
                return;
            }
            if (!isValidEmail(newData.email)) {
                layer.msg('邮箱格式不正确，请重新输入', { icon: 5 });
                $('#emailInput').focus();
                return;
            }
            if (!isValidPhoneCN(newData.phone)) {
                layer.msg('手机号格式不正确，请输入11位中国大陆手机号', { icon: 5 });
                $('#phoneInput').focus();
                return;
            }

            var changed = false;
            // 与 originalData 对比（注意 originalData 里建议也存 trim 后的值）
            if (newData.realName !== originalData.realName) {
                changed = true;
            }
            if (newData.phone !== originalData.phone) {
                changed = true;
            }
            if (newData.email !== originalData.email) {
                changed = true;
            }
            if (!changed) {
                layer.msg('未检测到任何修改，无需保存', { icon: 0, time: 1200 });
                // 切换按钮显示状态
                $('#saveBtn').hide();
                $('#cancelBtn').hide();
                $('#editBtn').show();

                // 切换字段为查看状态
                $('#realNameInput').hide();
                $('#realNameText').text(originalData.realName).show();

                $('#emailInput').hide();
                $('#emailText').text(originalData.email || '未填写').show();
                if (originalData.email) $('#emailText').removeClass('null');
                else $('#emailText').addClass('null');

                $('#phoneInput').hide();
                $('#phoneText').text(originalData.phone || '未填写').show();
                if (originalData.phone) $('#phoneText').removeClass('null');
                else $('#phoneText').addClass('null');

                isEditing = false;
                return; // 不提交
            }

            // 发送请求保存数据
            var idx = layer.load(2, { shade: 0.25 });
            $.ajax({
                url: '/Home/SavePersonalInfo',
                type: 'POST',
                data: newData,
                success: function (res) {
                    layer.close(idx);
                    if (res.code == 0) {
                        layer.msg(res.msg, { icon: 1, time: 800 }, function () {
                            // 更新页面显示
                            $('#realNameText').text(newData.realName).show();
                            $('#realNameInput').hide();

                            $('#emailText').text(newData.email || '未填写').show();
                            if (newData.email) $('#emailText').removeClass('null');
                            else $('#emailText').addClass('null');
                            $('#emailInput').hide();

                            $('#phoneText').text(newData.phone || '未填写').show();
                            if (newData.phone) $('#phoneText').removeClass('null');
                            else $('#phoneText').addClass('null');
                            $('#phoneInput').hide();

                            // 更新原始数据
                            originalData = {
                                realName: newData.realName,
                                email: newData.email,
                                phone: newData.phone
                            };

                            // 切换按钮状态
                            $('#saveBtn').hide();
                            $('#cancelBtn').hide();
                            $('#editBtn').show();
                            isEditing = false;
                        });
                    } else {
                        layui.layer.msg(res.msg || res.message || '退出失败', { icon: 5 });
                    }
                },
                error: function () {
                    layer.close(idx);
                    layer.msg('网络异常，请稍后重试', { icon: 5 });
                }
            });
        });
    });

    // ====== 校验函数：邮箱/手机号 ======
    function isValidEmail(email) {
        // 允许空（表示未填写）；不为空时校验格式
        if (!email) return true;
        // 相对通用的邮箱正则（避免过度严格）
        var re = /^[A-Za-z0-9._%+-]+@@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/;
        return re.test(email);
    }

    function isValidPhoneCN(phone) {
        // 允许空（表示未填写）；不为空时校验格式
        if (!phone) return true;

        // 去掉空格/短横线等常见分隔符
        phone = phone.replace(/[\s-]/g, '');

        // 中国大陆手机号：1开头，第二位3-9，共11位
        var re = /^1[3-9]\d{9}$/;
        return re.test(phone);
    }

    // 统一处理空值：null/undefined -> ''，并 trim
    function norm(v) {
        return (v || '').toString().trim();
    }

</script>