
@{
    ViewBag.Title = "修改密码";
}

<style>
    :root {
        --bg1: #0b1220;
        --bg2: #0a2a43;
        --card: #0f1b2d;
        --text: #e8eef7;
        --muted: #9fb2c8;
        --line: rgba(255,255,255,.10);
        --primary: #3b82f6;
        --primary2: #60a5fa;
        --danger: #ef4444;
        --shadow: 0 20px 60px rgba(0,0,0,.45);
        --radius: 12px;
        font-family: ui-sans-serif, system-ui, -apple-system, "PingFang SC","Microsoft YaHei", Arial;
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        background: linear-gradient(180deg, var(--bg1), var(--bg2));
        color: var(--text);
        padding: 24px;
        min-height: 100vh;
    }

    .pwd-container {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .pwd-header {
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--line);
    }

    .pwd-title {
        font-size: 18px;
        font-weight: 600;
        margin: 0;
    }

    .pwd-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .pwd-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .pwd-label {
        color: var(--muted);
        font-size: 13px;
    }

    .pw-box {
        position: relative;
    }

    .pwd-input {
        width: 100%;
        padding: 8px 12px 8px 48px;
        background: rgba(255,255,255,.06);
        border: 1px solid var(--line);
        border-radius: 8px;
        color: var(--text);
        font-size: 14px;
        outline: none;
        transition: border .2s;
    }

        .pwd-input:focus {
            border-color: var(--primary);
            background: rgba(255,255,255,.08);
        }

        .pwd-input::placeholder {
            color: rgba(255,255,255,.3);
        }

    .pwd-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--muted);
        font-size: 16px;
    }

    .toggle {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        border: 0;
        color: rgba(255,255,255,.75);
        cursor: pointer;
        width: 24px;
        height: 24px;
        display: grid;
        place-items: center;
        border-radius: 6px;
        transition: all .2s;
    }

        .toggle:hover {
            background: rgba(255,255,255,.06);
        }

    .pwd-footer {
        margin-top: 20px;
        padding-top: 12px;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .btn {
        padding: 6px 14px;
        border: 0;
        border-radius: 8px;
        font-size: 13px;
        cursor: pointer;
        transition: all .2s;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--primary), var(--primary2));
        color: white;
    }

    .btn-default {
        background: rgba(255,255,255,.06);
        color: var(--text);
        border: 1px solid var(--line);
    }

    .btn:hover {
        filter: brightness(1.1);
    }

    .error-tip {
        color: #f87171;
        font-size: 12px;
        margin-top: 4px;
        display: none;
    }
</style>

<div class="pwd-container">
    <div class="pwd-header">
        <h3 class="pwd-title">修改密码</h3>
    </div>

    <div class="pwd-body">
        <!-- 隐藏域传递用户ID -->
        <input type="hidden" name="Id" value="@ViewBag.Id">

        <!-- 原密码 -->
        <div class="pwd-field">
            <label class="pwd-label">原密码</label>
            <div class="pw-box">
                <i class="layui-icon layui-icon-password pwd-icon"></i>
                <input type="password" class="pwd-input" id="oldPassword" placeholder="请输入原密码">
                <button type="button" class="toggle" id="toggleOld">
                    <i class="layui-icon layui-icon-eye-invisible" id="oldIcon"></i>
                </button>
            </div>
            <div class="error-tip" id="oldPwdError"></div>
        </div>

        <!-- 新密码 -->
        <div class="pwd-field">
            <label class="pwd-label">新密码</label>
            <div class="pw-box">
                <i class="layui-icon layui-icon-vercode pwd-icon"></i>
                <input type="password" class="pwd-input" id="newPassword" placeholder="请输入新密码（不少于6位）">
                <button type="button" class="toggle" id="toggleNew">
                    <i class="layui-icon layui-icon-eye-invisible" id="newIcon"></i>
                </button>
            </div>
            <div class="error-tip" id="newPwdError"></div>
        </div>

        <!-- 确认密码 -->
        <div class="pwd-field">
            <label class="pwd-label">确认密码</label>
            <div class="pw-box">
                <i class="layui-icon layui-icon-vercode pwd-icon"></i>
                <input type="password" class="pwd-input" id="confirmPassword" placeholder="请再次输入新密码">
                <button type="button" class="toggle" id="toggleConfirm">
                    <i class="layui-icon layui-icon-eye-invisible" id="confirmIcon"></i>
                </button>
            </div>
            <div class="error-tip" id="confirmPwdError"></div>
        </div>
    </div>

    <div class="pwd-footer">
        <button class="btn btn-default" onclick="parent.layer.closeAll()">取消</button>
        <button class="btn btn-primary" id="savePwdBtn">保存密码</button>
    </div>
</div>


<script>
    layui.use(['layer'], function () {
        var layer = layui.layer;

        // 密码显示/隐藏切换
        function togglePwd(inputId, iconId) {
            var input = $('#' + inputId);
            var icon = $('#' + iconId);
            if (input.attr('type') === 'password') {
                input.attr('type', 'text');
                icon.attr('class', 'layui-icon layui-icon-eye');
            } else {
                input.attr('type', 'password');
                icon.attr('class', 'layui-icon layui-icon-eye-invisible');
            }
        }

        // 绑定切换事件
        $('#toggleOld').click(function () { togglePwd('oldPassword', 'oldIcon'); });
        $('#toggleNew').click(function () { togglePwd('newPassword', 'newIcon'); });
        $('#toggleConfirm').click(function () { togglePwd('confirmPassword', 'confirmIcon'); });

        // 保存密码
        $('#savePwdBtn').click(function () {
            // 获取输入值
            var userId = $('input[name="Id"]').val();
            var oldPassword = $('#oldPassword').val().trim();
            var newPassword = $('#newPassword').val().trim();
            var confirmPassword = $('#confirmPassword').val().trim();

            // 清空错误提示
            $('.error-tip').hide().text('');

            // 验证
            if (!oldPassword) {
                $('#oldPwdError').text('请输入原密码').show();
                return;
            }
            if (!newPassword || newPassword.length < 6) {
                $('#newPwdError').text('新密码长度不能少于6位').show();
                return;
            }
            if (newPassword !== confirmPassword) {
                $('#confirmPwdError').text('两次输入的密码不一致').show();
                return;
            }
            if (oldPassword === newPassword) {
                $('#newPwdError').text('新密码不能与原密码相同').show();
                return;
            }

            // 提交请求
            var idx = layer.load(2, { shade: 0.25 });
            $.ajax({
                url: '/Home/ChangePassword',
                type: 'POST',
                data: {
                    Id: userId,
                    OldPassword: oldPassword,
                    NewPassword: newPassword
                },
                success: function (res) {
                    layer.close(idx);
                    if (res.code === 0) {
                        layer.msg(res.msg, { icon: 1, time: 1000 }, function () {
                            parent.layer.closeAll();
                            // 可选：修改成功后可提示用户重新登录
                            // parent.layer.msg('请使用新密码重新登录', { icon: 6 });
                        });
                    } else {
                        layer.msg(res.msg , { icon: 5 });
                    }
                },
                error: function () {
                    layer.close(idx);
                    layer.msg('网络异常，请稍后重试', { icon: 5 });
                }
            });
        });
    });
</script>

