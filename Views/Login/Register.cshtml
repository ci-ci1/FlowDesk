
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>用户注册</title>
    <link href="~/Content/layui/css/layui.css" rel="stylesheet" />
    <style>
        :root {
            --bg1: #0b1220;
            --bg2: #0a2a43;
            --card: #0f1b2d;
            --text: #e8eef7;
            --muted: #9fb2c8;
            --line: rgba(255,255,255,.10);
            --primary: #3b82f6;
            --primary2: #60a5fa;
            --danger: #ef4444;
            --shadow: 0 20px 60px rgba(0,0,0,.45);
            --radius: 16px;
            font-family: ui-sans-serif, system-ui, -apple-system, "PingFang SC","Microsoft YaHei", Arial;
        }

        * {
            box-sizing: border-box
        }

        body {
            margin: 0;
            min-height: 100vh;
            color: var(--text);
            background: radial-gradient(1200px 600px at 20% 10%, rgba(59,130,246,.25), transparent 55%), radial-gradient(900px 500px at 85% 20%, rgba(96,165,250,.18), transparent 60%), linear-gradient(180deg, var(--bg1), var(--bg2));
            display: grid;
            place-items: center;
            padding: 24px;
        }

        .wrap {
            width: min(980px, 100%);
            display: grid;
            grid-template-columns: 1.1fr .9fr;
            gap: 24px;
        }

        .brand {
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 28px;
            background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.02));
            box-shadow: var(--shadow);
            position: relative;
            overflow: hidden;
        }

            .brand::before {
                content: "";
                position: absolute;
                inset: -60px;
                background: radial-gradient(circle at 30% 30%, rgba(59,130,246,.18), transparent 55%), radial-gradient(circle at 70% 40%, rgba(96,165,250,.12), transparent 55%);
                filter: blur(10px);
            }

            .brand > * {
                position: relative
            }

        .logo {
            display: flex;
            gap: 12px;
            margin-bottom: 18px;
            align-items: center;
        }

        .mark {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--primary), var(--primary2));
            display: grid;
            place-items: center;
            font-weight: 800;
            box-shadow: 0 12px 30px rgba(59,130,246,.25);
        }

        .brand h1 {
            margin: 0;
            font-size: 22px
        }

        .brand p {
            margin-top: 10px;
            color: var(--muted);
            line-height: 1.7
        }

        .bullets {
            margin: 18px 0 0;
            padding-left: 18px;
            color: var(--muted);
            line-height: 1.9;
        }

        .card {
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 28px;
            background: rgba(15,27,45,.82);
            backdrop-filter: blur(10px);
            box-shadow: var(--shadow);
        }

            .card h2 {
                margin: 0 0 6px;
                font-size: 20px
            }

        .sub {
            margin-bottom: 18px;
            font-size: 13px;
            color: var(--muted)
        }

        .field {
            margin: 12px 0
        }

        label {
            display: block;
            font-size: 13px;
            color: var(--muted);
            margin-bottom: 6px;
        }

        .input {
            width: 100%;
            border: 1px solid rgba(255,255,255,.14);
            background: rgba(255,255,255,.04);
            color: var(--text);
            border-radius: 12px;
            padding: 12px;
        }

        .row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 10px 0;
        }

        .checkbox {
            display: flex;
            gap: 8px;
            font-size: 13px;
            color: var(--muted);
            align-items: center;
        }

            .checkbox .layui-form-checkbox {
                margin: 0 !important;
                vertical-align: middle;
            }

        .link {
            color: #b9d4ff;
            font-size: 13px;
            text-decoration: none;
        }

        .btn {
            width: 100%;
            margin-top: 14px;
            border: 0;
            border-radius: 12px;
            padding: 12px;
            background: linear-gradient(135deg, var(--primary), var(--primary2));
            color: #fff;
            font-weight: 700;
            cursor: pointer;
        }

        .pw-box {
            position: relative
        }

            .pw-box .input {
                padding-right: 52px
            }

        .toggle {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: transparent;
            border: 0;
            cursor: pointer;
            color: rgba(255,255,255,.75);
        }

        .error {
            margin-top: 10px;
            padding: 10px 12px;
            border-radius: 12px;
            background: rgba(239,68,68,.12);
            border: 1px solid rgba(239,68,68,.28);
            display: none;
            font-size: 13px;
        }

        .footer {
            margin-top: 14px;
            text-align: center;
            font-size: 12px;
            color: rgba(255,255,255,.45);
        }
    </style>
</head>
<body>
    <div class="wrap">
        <section class="brand">
            <div class="logo">
                <div class="mark">A</div>
                <div>
                    <h1>后台管理系统</h1>
                    <div style="font-size:13px;color:rgba(255,255,255,.55)">Admin Console</div>
                </div>
            </div>
            <p>请填写信息完成管理员账号注册。</p>
            <ul class="bullets">
                <li>自定义 UI + layui 行为</li>
                <li>密码可见切换</li>
                <li>表单验证 + 协议勾选</li>
            </ul>
        </section>

        <main class="card">
            <h2>注册</h2>
            <p class="sub">请填写完整的注册信息</p>

            <form class="layui-form" lay-filter="registerForm">
                <!-- 用户名 -->
                <div class="field layui-form-item">
                    <label>用户名</label>
                    <div class="layui-input-wrap">
                        <input class="input layui-input"
                               name="UserName"
                               lay-verify="required|username"
                               lay-reqtext="请输入用户名"
                               placeholder="请输入用户名" />
                    </div>
                </div>

                <!-- 手机号/邮箱 -->
                <div class="field layui-form-item">
                    <label>联系电话</label>
                    <div class="layui-input-wrap">
                        <input class="input layui-input"
                               name="Phone"
                               lay-verify="required|phone"
                               lay-reqtext="请输入正确的手机号"
                               placeholder="请输入手机号" />
                    </div>
                </div>

                <!-- 密码 -->
                <div class="field layui-form-item">
                    <label>密码</label>
                    <div class="layui-input-wrap pw-box">
                        <input class="input layui-input"
                               id="Password"
                               name="Password"
                               type="password"
                               lay-verify="required|pass"
                               lay-reqtext="密码长度不少于6位"
                               placeholder="请设置密码" />
                        <button type="button" class="toggle" id="togglePw1">
                            <i class="layui-icon layui-icon-eye-invisible" id="pwIcon1"></i>
                        </button>
                    </div>
                </div>

                <!-- 确认密码 -->
                <div class="field layui-form-item">
                    <label>确认密码</label>
                    <div class="layui-input-wrap pw-box">
                        <input class="input layui-input"
                               id="repassword"
                               name="repassword"
                               type="password"
                               lay-verify="required|confirmPass"
                               lay-reqtext="两次密码输入不一致"
                               placeholder="请再次输入密码" />
                        <button type="button" class="toggle" id="togglePw2">
                            <i class="layui-icon layui-icon-eye-invisible" id="pwIcon2"></i>
                        </button>
                    </div>
                </div>

                <!-- 协议勾选 -->
                <div class="row layui-form-item">
                    <label class="checkbox">
                        <input type="checkbox" name="agree" lay-skin="primary" lay-verify="agree" title="同意" />
                        我已阅读并同意<a href="javascript:;" class="link" style="padding:0 2px">《用户协议》</a>和<a href="javascript:;" class="link" style="padding:0 2px">《隐私政策》</a>
                    </label>
                </div>

                <!-- 注册按钮 -->
                <button class="btn" lay-submit lay-filter="register">完成注册</button>

                <!-- 错误提示 -->
                <div class="error" id="errorBox"></div>

                <!-- 登录入口 -->
                <div class="row" style="margin-top:15px;">
                    <div style="width:100%;text-align:center;">
                        已有账号？<a class="link" href="/Login/LoginIndex" id="toLogin">立即登录</a>
                    </div>
                </div>

                <div class="footer">
                    © <span id="year"></span> Your Company
                </div>
            </form>
        </main>
    </div>


    <script src="~/Content/layui/layui.js"></script>
    <script src="~/Scripts/jquery-3.4.1.js"></script>

    <script>
        layui.use(['form', 'layer'], function () {
            var form = layui.form;
            var layer = layui.layer;

            // 设置年份
            $('#year').text(new Date().getFullYear());

            // 自定义表单验证规则
            form.verify({
                // 用户名验证
                username: function (value) {
                    if (value.length < 3) {
                        return '用户名长度不能少于3位';
                    }
                    if (!/^[a-zA-Z0-9_]+$/.test(value)) {
                        return '用户名只能包含字母、数字和下划线';
                    }
                },
                // 手机号正则验证
                phone: function (value) {
                    // 中国大陆手机号正则：1开头，第二位3-9，后面9位数字
                    var phoneReg = /^1[3-9]\d{9}$/;
                    if (!phoneReg.test(value)) {
                        return '请输入正确的中国大陆手机号';
                    }
                },
                // 密码验证
                pass: function (value) {
                    if (value.length < 6) {
                        return '密码长度不能少于6位';
                    }
                },
                // 确认密码验证
                confirmPass: function (value) {
                    if (value !== $('#Password').val()) {
                        return '两次输入的密码不一致';
                    }
                },
                // 协议勾选验证
                agree: function (value) {
                    // 检查复选框是否勾选
                    if (!$('input[name="agree"]').is(':checked')) {
                        return '请先阅读并同意用户协议和隐私政策';
                    }
                }
            });

            // 密码显示/隐藏切换 - 密码框1
            $('#togglePw1').on('click', function () {
                var input = $('#Password');
                var icon = $('#pwIcon1');
                togglePwdType(input, icon);
            });

            // 密码显示/隐藏切换 - 密码框2
            $('#togglePw2').on('click', function () {
                var input = $('#repassword');
                var icon = $('#pwIcon2');
                togglePwdType(input, icon);
            });

            // 通用密码显/隐切换函数
            function togglePwdType(input, icon) {
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.attr('class', 'layui-icon layui-icon-eye');
                } else {
                    input.attr('type', 'password');
                    icon.attr('class', 'layui-icon layui-icon-eye-invisible');
                }
            }

            // 注册表单提交
            form.on('submit(register)', function (data) {
                var field = data.field;
                var idx = layer.load(2, { shade: 0.25 });

                $.ajax({
                    url: "/Login/Save",
                    type: "post",
                    data: field,
                    success: function (res) {
                        layer.close(idx);
                        if (res.code == 0) {
                            layer.msg(res.msg, { icon: 6, time: 1000 }, function () {
                                window.location.href = "/Login/LoginIndex";
                            });
                        } else {
                            $('#errorBox').text(res.msg).fadeIn();
                        }
                    },
                    error: function () {
                        layer.close(idx);
                        layer.msg('网络异常，请稍后重试', { icon: 5 });
                    }
                })

                return false;
            });

            // 用户协议/隐私政策点击事件
            $('.link').on('click', function () {
                if ($(this).text() === '《用户协议》') {
                    layer.open({
                        title: '用户协议',
                        content: '<div style="padding:20px;line-height:1.8;">' +
                            '1. 注册账号需遵守相关法律法规<br/>' +
                            '2. 不得利用账号从事违法违规活动<br/>' +
                            '3. 请妥善保管自己的账号信息</div>',
                        area: ['500px', '300px']
                    });
                } else if ($(this).text() === '《隐私政策》') {
                    layer.open({
                        title: '隐私政策',
                        content: '<div style="padding:20px;line-height:1.8;">' +
                            '1. 我们会保护您的个人信息安全<br/>' +
                            '2. 不会向第三方泄露您的信息<br/>' +
                            '3. 您可以随时申请注销账号</div>',
                        area: ['500px', '300px']
                    });
                }
            });
        });
    </script>
</body>
</html>