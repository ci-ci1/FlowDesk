
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>用户登录</title>
    <link href="~/Content/layui/css/layui.css" rel="stylesheet" />
    <style>
        :root {
            --bg1: #0b1220;
            --bg2: #0a2a43;
            --card: #0f1b2d;
            --text: #e8eef7;
            --muted: #9fb2c8;
            --line: rgba(255,255,255,.10);
            --primary: #3b82f6;
            --primary2: #60a5fa;
            --danger: #ef4444;
            --shadow: 0 20px 60px rgba(0,0,0,.45);
            --radius: 16px;
            font-family: ui-sans-serif, system-ui, -apple-system, "PingFang SC","Microsoft YaHei", Arial;
        }

        * {
            box-sizing: border-box
        }

        body {
            margin: 0;
            min-height: 100vh;
            color: var(--text);
            background: radial-gradient(1200px 600px at 20% 10%, rgba(59,130,246,.25), transparent 55%), radial-gradient(900px 500px at 85% 20%, rgba(96,165,250,.18), transparent 60%), linear-gradient(180deg, var(--bg1), var(--bg2));
            display: grid;
            place-items: center;
            padding: 24px;
        }

        .wrap {
            width: min(980px, 100%);
            display: grid;
            grid-template-columns: 1.1fr .9fr;
            gap: 24px;
        }



        .brand {
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 28px;
            background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.02));
            box-shadow: var(--shadow);
            position: relative;
            overflow: hidden;
        }

            .brand::before {
                content: "";
                position: absolute;
                inset: -60px;
                background: radial-gradient(circle at 30% 30%, rgba(59,130,246,.18), transparent 55%), radial-gradient(circle at 70% 40%, rgba(96,165,250,.12), transparent 55%);
                filter: blur(10px);
            }

            .brand > * {
                position: relative
            }

        .logo {
            display: flex;
            gap: 12px;
            margin-bottom: 18px;
            align-items: center;
        }

        .mark {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--primary), var(--primary2));
            display: grid;
            place-items: center;
            font-weight: 800;
            box-shadow: 0 12px 30px rgba(59,130,246,.25);
        }

        .brand h1 {
            margin: 0;
            font-size: 22px
        }

        .brand p {
            margin-top: 10px;
            color: var(--muted);
            line-height: 1.7
        }

        .bullets {
            margin: 18px 0 0;
            padding-left: 18px;
            color: var(--muted);
            line-height: 1.9;
        }

        .card {
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 28px;
            background: rgba(15,27,45,.82);
            backdrop-filter: blur(10px);
            box-shadow: var(--shadow);
        }

            .card h2 {
                margin: 0 0 6px;
                font-size: 20px
            }

        .sub {
            margin-bottom: 18px;
            font-size: 13px;
            color: var(--muted)
        }

        .field {
            margin: 12px 0
        }

        label {
            display: block;
            font-size: 13px;
            color: var(--muted);
            margin-bottom: 6px;
        }

        .input {
            width: 100%;
            border: 1px solid rgba(255,255,255,.14);
            background: rgba(255,255,255,.04);
            color: var(--text);
            border-radius: 12px;
            padding: 12px;
        }

        .row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 10px 0;
        }

        .checkbox {
            display: flex;
            gap: 8px;
            font-size: 13px;
            color: var(--muted);
            /* 新增：让复选框和文字垂直居中对齐 */
            align-items: center;
        }

            /* 新增：修复layui复选框的默认垂直对齐问题 */
            .checkbox .layui-form-checkbox {
                margin: 0 !important;
                vertical-align: middle;
            }

        .link {
            color: #b9d4ff;
            font-size: 13px;
            text-decoration: none;
        }

        .btn {
            width: 100%;
            margin-top: 14px;
            border: 0;
            border-radius: 12px;
            padding: 12px;
            background: linear-gradient(135deg, var(--primary), var(--primary2));
            color: #fff;
            font-weight: 700;
            cursor: pointer;
        }

        .pw-box {
            position: relative
        }

            .pw-box .input {
                padding-right: 52px
            }

        .toggle {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: transparent;
            border: 0;
            cursor: pointer;
            color: rgba(255,255,255,.75);
        }

        .error {
            margin-top: 10px;
            padding: 10px 12px;
            border-radius: 12px;
            background: rgba(239,68,68,.12);
            border: 1px solid rgba(239,68,68,.28);
            display: none;
            font-size: 13px;
        }

        .footer {
            margin-top: 14px;
            text-align: center;
            font-size: 12px;
            color: rgba(255,255,255,.45);
        }
    </style>
</head>
<body>
    <div class="wrap">
        <section class="brand">
            <div class="logo">
                <div class="mark">A</div>
                <div>
                    <h1>后台管理系统</h1>
                    <div style="font-size:13px;color:rgba(255,255,255,.55)">Admin Console</div>
                </div>
            </div>
            <p>请输入账号密码登录后台。</p>
            <ul class="bullets">
                <li>自定义 UI + layui 行为</li>
                <li>密码可见切换</li>
                <li>结构对齐官方示例</li>
            </ul>
        </section>

        <main class="card">
            <h2>登录</h2>
            <p class="sub">请输入管理员账号</p>

            <form class="layui-form" lay-filter="loginForm">

                <div class="field layui-form-item">
                    <label>账号</label>
                    <div class="layui-input-wrap">
                        <input class="input layui-input"
                               name="username"
                               lay-verify="required"
                               lay-reqtext="请输入账号"
                    </div>
                </div>

                <div class="field layui-form-item">
                    <label>密码</label>
                    <div class="layui-input-wrap pw-box">
                        <input class="input layui-input"
                               id="password"
                               name="password"
                               type="password"
                               lay-verify="required"
                               lay-reqtext="请输入密码" />
                        <button type="button" class="toggle" id="togglePw">
                            <i class="layui-icon layui-icon-eye-invisible" id="pwIcon"></i>
                        </button>
                    </div>
                </div>

                <div class="row layui-form-item">
                    <div>
                        <a class="link" href="javascript:;" id="register">注册</a>
                        &nbsp;
                        <a class="link" href="javascript:;" id="forgot">忘记密码？</a>
                    </div>
                </div>

                <button class="btn" lay-submit lay-filter="login">登录</button>

                <div class="error" id="errorBox"></div>

                <div class="footer">
                    © <span id="year"></span> Your Company
                </div>

            </form>
        </main>
    </div>


    <script src="~/Content/layui/layui.js"></script>
    <script src="~/Scripts/jquery-3.4.1.js"></script>
    <script>

        layui.use(['form', 'layer'], function () {
            var form = layui.form;
            var layer = layui.layer;

            $('#year').text(new Date().getFullYear());

            form.on('submit(login)', function (data) {
                var field = data.field;
                var idx = layer.load(2, { shade: 0.25 });


                //点击登录
                $.ajax({
                    url: "/Login/Login",
                    type: "POST",
                    data: field,
                    success: function (res) {
                        layer.close(idx);
                        if (res.code == 0) {
                            layer.msg(res.msg, { icon: 6, time: 1000 }, function () {
                                window.location.href = "/Home/Index?fresh=1";
                            });
                        } else {
                            $('#errorBox').text(res.msg).fadeIn();
                        }
                    },
                })


                return false;
            });


            //密码显示 / 隐藏切换
            $('#togglePw').on('click', function () {
                var input = $('#password');
                var icon = $('#pwIcon');

                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.attr('class', 'layui-icon layui-icon-eye');
                } else {
                    input.attr('type', 'password');
                    icon.attr('class', 'layui-icon layui-icon-eye-invisible');
                }
            });


            //忘记密码
            $('#forgot').on('click', function () {
                layer.alert('请联系系统管理员重置密码');
            });


            //注册用户
            $('#register').on('click', function () {
                location.href = "/Login/Register";
            });
        });
    </script>
</body>
</html>











