@using FlowDesk.Models
@{
    ViewBag.Title = "字典项";
    Layout = null;
    var type = ViewBag.Type as DictTypes;
}

<link href="~/Content/layui/css/layui.css" rel="stylesheet" />

<div style="padding:15px;">
    <blockquote class="layui-elem-quote layui-text">
        字典项管理：@(type.Name)（Code=@type.Code）
    </blockquote>

    <div class="layui-form layui-card" style="padding:15px;">
        <div class="layui-row layui-col-space12">
            <div class="layui-col-md4">
                <input type="text" id="keyword" placeholder="关键词：Label/Value" class="layui-input" />
            </div>
            <div class="layui-col-md8" style="text-align:right;">
                <button class="layui-btn" id="btnSearch"><i class="layui-icon layui-icon-search"></i> 查询</button>
                <button class="layui-btn layui-btn-normal" id="btnAdd"><i class="layui-icon layui-icon-add-1"></i> 新增字典项</button>
            </div>
        </div>
    </div>

    <table id="itemTable" lay-filter="itemTable"></table>

    <script type="text/html" id="itemOpTpl">
        <a class="layui-btn layui-btn-normal layui-btn-xs" lay-event="edit">编辑</a>
    </script>
</div>

<script src="~/Scripts/jquery-3.4.1.js"></script>
<script src="~/Content/layui/layui.js"></script>
<script>
layui.use(['table','layer','form'], function(){
    var table = layui.table;
    var layer = layui.layer;
    var $ = layui.$;

    var typeId = @type.Id;

    table.render({
        elem:'#itemTable',
        id:'itemTable',
        url:'/System/DictItemListJson',
        method:'get',
        where:{ typeId: typeId },
        page:true,
        limit:50,
        cols:[[
            { field:'Id', title:'ID', width:80 },
            { field:'Label', title:'Label', width:200 },
            { field:'Value', title:'Value', width:200 },
            { field:'Sort', title:'Sort', width:80 },
            { field:'Status', title:'状态', width:90, templet:function(d){ return d.Status==1?'启用':'禁用'; } },
            { field:'Remark', title:'备注', minWidth:200 },
            { fixed:'right', title:'操作', width:100, toolbar:'#itemOpTpl' }
        ]]
    });

    $('#btnSearch').on('click', function(){
        table.reload('itemTable', { page:{curr:1}, where:{ typeId:typeId, keyword: $('#keyword').val() } });
    });

    $('#btnAdd').on('click', function(){
        layer.open({
            type: 1,
            title: '新增字典项',
            area: ['560px','380px'],
            content:
              '<div style="padding:15px;" class="layui-form">'
            + '  <div class="layui-form-item"><label class="layui-form-label">Label</label><div class="layui-input-block"><input id="l" class="layui-input"/></div></div>'
            + '  <div class="layui-form-item"><label class="layui-form-label">Value</label><div class="layui-input-block"><input id="v" class="layui-input"/></div></div>'
            + '  <div class="layui-form-item"><label class="layui-form-label">Sort</label><div class="layui-input-block"><input id="s" value="0" class="layui-input"/></div></div>'
            + '  <div class="layui-form-item"><label class="layui-form-label">Remark</label><div class="layui-input-block"><input id="r" class="layui-input"/></div></div>'
            + '</div>',
            btn: ['保存','取消'],
            yes: function(index){
                $.post('/System/DictItemCreate', { typeId:typeId, label:$('#l').val(), value:$('#v').val(), sort:$('#s').val(), remark:$('#r').val() }, function(res){
                    if(res.code===0){
                        layer.close(index);
                        table.reload('itemTable');
                    }else{
                        layer.msg(res.msg||'失败', {icon:5});
                    }
                });
            }
        });
    });

    table.on('tool(itemTable)', function(obj){
        var d = obj.data;
        if(obj.event==='edit'){
            layer.open({
                type: 1,
                title: '编辑字典项',
                area: ['560px','420px'],
                content:
                  '<div style="padding:15px;" class="layui-form">'
                + '  <div class="layui-form-item"><label class="layui-form-label">Label</label><div class="layui-input-block"><input id="el" value="'+(d.Label||'')+'" class="layui-input"/></div></div>'
                + '  <div class="layui-form-item"><label class="layui-form-label">Value</label><div class="layui-input-block"><input id="ev" value="'+(d.Value||'')+'" class="layui-input"/></div></div>'
                + '  <div class="layui-form-item"><label class="layui-form-label">Sort</label><div class="layui-input-block"><input id="es" value="'+(d.Sort||0)+'" class="layui-input"/></div></div>'
                + '  <div class="layui-form-item"><label class="layui-form-label">Status</label><div class="layui-input-block"><select id="est"><option value="1">启用</option><option value="0">禁用</option></select></div></div>'
                + '  <div class="layui-form-item"><label class="layui-form-label">Remark</label><div class="layui-input-block"><input id="er" value="'+(d.Remark||'')+'" class="layui-input"/></div></div>'
                + '</div>',
                success: function(){ $('#est').val(d.Status); layui.form.render('select'); },
                btn: ['保存','取消'],
                yes: function(index){
                    $.post('/System/DictItemEdit', { id:d.Id, label:$('#el').val(), value:$('#ev').val(), sort:$('#es').val(), status:$('#est').val(), remark:$('#er').val() }, function(res){
                        if(res.code===0){
                            layer.close(index);
                            table.reload('itemTable');
                        }else{
                            layer.msg(res.msg||'失败', {icon:5});
                        }
                    });
                }
            });
        }
    });
});
</script>