@{
    ViewBag.Title = "数据字典";
    Layout = null;
}
<link href="~/Content/layui/css/layui.css" rel="stylesheet" />

<div style="padding:15px;">
    <blockquote class="layui-elem-quote layui-text">数据字典 - 类型管理</blockquote>

    <div class="layui-form layui-card" style="padding:15px;">
        <div class="layui-row layui-col-space12">
            <div class="layui-col-md4">
                <input type="text" id="keyword" placeholder="关键词：Code/Name" class="layui-input" />
            </div>
            <div class="layui-col-md8" style="text-align:right;">
                <button class="layui-btn" id="btnSearch"><i class="layui-icon layui-icon-search"></i> 查询</button>
                <button class="layui-btn layui-btn-normal" id="btnAdd"><i class="layui-icon layui-icon-add-1"></i> 新增类型</button>
            </div>
        </div>
    </div>

    <table id="typeTable" lay-filter="typeTable"></table>

    <script type="text/html" id="opTpl">
        <a class="layui-btn layui-btn-xs" lay-event="items">字典项</a>
        <a class="layui-btn layui-btn-normal layui-btn-xs" lay-event="edit">编辑</a>
    </script>
</div>

<script src="~/Scripts/jquery-3.4.1.js"></script>
<script src="~/Content/layui/layui.js"></script>
<script>
layui.use(['table','layer','form'], function(){
    var table = layui.table;
    var layer = layui.layer;
    var $ = layui.$;

    table.render({
        elem:'#typeTable',
        id:'typeTable',
        url:'/System/DictTypeListJson',
        method:'get',
        page:true,
        limit:20,
        cols:[[
            { field:'Id', title:'ID', width:80 },
            { field:'Code', title:'Code', width:200 },
            { field:'Name', title:'Name', width:200 },
            { field:'Status', title:'状态', width:90, templet:function(d){ return d.Status==1?'启用':'禁用'; } },
            { field:'Remark', title:'备注', minWidth:200 },
            { fixed:'right', title:'操作', width:160, toolbar:'#opTpl' }
        ]]
    });

    $('#btnSearch').on('click', function(){
        table.reload('typeTable', { page:{curr:1}, where:{ keyword: $('#keyword').val() } });
    });

    $('#btnAdd').on('click', function(){
        layer.open({
            type: 1,
            title: '新增字典类型',
            area: ['520px','320px'],
            content:
              '<div style="padding:15px;" class="layui-form">'
            + '  <div class="layui-form-item"><label class="layui-form-label">Code</label><div class="layui-input-block"><input id="c" class="layui-input"/></div></div>'
            + '  <div class="layui-form-item"><label class="layui-form-label">Name</label><div class="layui-input-block"><input id="n" class="layui-input"/></div></div>'
            + '  <div class="layui-form-item"><label class="layui-form-label">Remark</label><div class="layui-input-block"><input id="r" class="layui-input"/></div></div>'
            + '</div>',
            btn: ['保存','取消'],
            yes: function(index){
                $.post('/System/DictTypeCreate', { code: $('#c').val(), name: $('#n').val(), remark: $('#r').val() }, function(res){
                    if(res.code===0){
                        layer.close(index);
                        table.reload('typeTable');
                    }else{
                        layer.msg(res.msg||'失败', {icon:5});
                    }
                });
            }
        });
    });

    table.on('tool(typeTable)', function(obj){
        var d = obj.data;
        if(obj.event==='items'){
            // 打开字典项页面
            layer.open({
                type: 2,
                title: '字典项 - ' + d.Name,
                content: '/System/DictItems?typeId=' + d.Id,
                area: ['1000px','650px']
            });
        }
        if(obj.event==='edit'){
            layer.open({
                type: 1,
                title: '编辑字典类型',
                area: ['520px','340px'],
                content:
                  '<div style="padding:15px;" class="layui-form">'
                + '  <div class="layui-form-item"><label class="layui-form-label">Code</label><div class="layui-input-block"><input disabled value="'+d.Code+'" class="layui-input"/></div></div>'
                + '  <div class="layui-form-item"><label class="layui-form-label">Name</label><div class="layui-input-block"><input id="en" value="'+(d.Name||'')+'" class="layui-input"/></div></div>'
                + '  <div class="layui-form-item"><label class="layui-form-label">Remark</label><div class="layui-input-block"><input id="er" value="'+(d.Remark||'')+'" class="layui-input"/></div></div>'
                + '  <div class="layui-form-item"><label class="layui-form-label">Status</label><div class="layui-input-block">'
                + '    <select id="es"><option value="1">启用</option><option value="0">禁用</option></select>'
                + '  </div></div>'
                + '</div>',
                success: function(){ $('#es').val(d.Status); layui.form.render('select'); },
                btn: ['保存','取消'],
                yes: function(index){
                    $.post('/System/DictTypeEdit', { id:d.Id, name: $('#en').val(), remark: $('#er').val(), status: $('#es').val() }, function(res){
                        if(res.code===0){
                            layer.close(index);
                            table.reload('typeTable');
                        }else{
                            layer.msg(res.msg||'失败', {icon:5});
                        }
                    });
                }
            });
        }
    });
});
</script>