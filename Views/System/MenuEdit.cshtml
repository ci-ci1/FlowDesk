@model FlowDesk.Models.Menus
@using FlowDesk.Models
@{
    ViewBag.Title = "编辑菜单";
    Layout = null;
    var roots = ViewBag.Roots as System.Collections.Generic.List<Menus>;
}

<link href="~/Content/layui/css/layui.css" rel="stylesheet" />

<div style="padding:15px;">
    <form class="layui-form" style="max-width:660px;">

        <div class="layui-form-item">
            <label class="layui-form-label">类型</label>
            <div class="layui-input-block">
                <input type="text" class="layui-input" value="@(Model.MenuType==1?"目录":"菜单")" disabled />
            </div>
        </div>

        @if (Model.MenuType == 2)
        {
            <div class="layui-form-item">
                <label class="layui-form-label">父目录</label>
                <div class="layui-input-block">
                    <select name="parentId">
                        <option value="0">请选择</option>
                        @if (roots != null)
                        {
                            foreach (var r in roots)
                            {
                                <option value="@r.Id" @(r.Id == Model.ParentId ? "selected" : "")>@r.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>
        }
        else
        {
            <input type="hidden" name="parentId" value="0" />
        }

        <div class="layui-form-item">
            <label class="layui-form-label">名称</label>
            <div class="layui-input-block">
                <input type="text" name="name" value="@Model.Name" required lay-verify="required" class="layui-input" />
            </div>
        </div>

        @if (Model.MenuType == 2)
        {
            <div class="layui-form-item">
                <label class="layui-form-label">Url</label>
                <div class="layui-input-block">
                    <input type="text" name="url" value="@Model.Url" class="layui-input" />
                </div>
            </div>
        }
        else
        {
            <input type="hidden" name="url" value="" />
        }

        <div class="layui-form-item">
            <label class="layui-form-label">Icon</label>
            <div class="layui-input-block">
                <input type="text" name="icon" value="@Model.Icon" class="layui-input" />
            </div>
        </div>

        <div class="layui-form-item">
            <label class="layui-form-label">排序</label>
            <div class="layui-input-block">
                <input type="number" name="sort" value="@Model.Sort" class="layui-input" />
            </div>
        </div>

        <div class="layui-form-item">
            <label class="layui-form-label">显示</label>
            <div class="layui-input-block">
                <input type="checkbox" name="isVisible" lay-skin="switch" lay-text="是|否" @(Model.IsVisible ? "checked" : "") />
            </div>
        </div>

        <div class="layui-form-item">
            <label class="layui-form-label">状态</label>
            <div class="layui-input-block">
                <input type="radio" name="status" value="1" title="启用" @(Model.Status == 1 ? "checked" : "") />
                <input type="radio" name="status" value="0" title="禁用" @(Model.Status == 0 ? "checked" : "") />
            </div>
        </div>

        <input type="hidden" name="id" value="@Model.Id" />

        <div class="layui-form-item">
            <div class="layui-input-block">
                <button class="layui-btn" lay-submit lay-filter="submit">保存</button>
            </div>
        </div>
    </form>
</div>

<script src="~/Scripts/jquery-3.4.1.js"></script>
<script src="~/Content/layui/layui.js"></script>

<script>
layui.use(['form','layer'], function(){
    var form = layui.form;
    var layer = layui.layer;
    var $ = layui.$;

    form.render();

    form.on('submit(submit)', function(data){
        $.post('/System/MenuEditPost', data.field, function(res){
            if(res.code===0){
                layer.msg('保存成功', {icon:1, time:600}, function(){
                    var index = parent.layer.getFrameIndex(window.name);
                    parent.layer.close(index);
                });
            }else{
                layer.msg(res.msg||'保存失败', {icon:5});
            }
        });
        return false;
    });
});
</script>