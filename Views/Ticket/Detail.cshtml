@model FlowDesk.Models.ViewModels.TicketDetailVM
@{
    ViewBag.Title = "工单详情";
    Layout = null;

    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;
    bool canOp = ViewBag.CanOperate != null && (bool)ViewBag.CanOperate;

    // 关联资产（后端 ViewBag.RelAssets = List<匿名对象>）
    var relAssets = ViewBag.RelAssets as dynamic;
}

@functions{
    public string StatusText(byte? s)
    {
        if (!s.HasValue) return "-";
        switch (s.Value)
        {
            case 1: return "新建";
            case 2: return "已受理";
            case 3: return "处理中";
            case 4: return "待确认";
            case 5: return "已完成";
            case 6: return "已关闭";
            default: return "状态" + s.Value;
        }
    }

    public string PriorityText(byte p)
    {
        switch (p)
        {
            case 1: return "低";
            case 2: return "中";
            case 3: return "高";
            case 4: return "紧急";
            default: return "P" + p;
        }
    }

    public string ActionText(string a)
    {
        switch (a)
        {
            case "CREATE": return "创建";
            case "ASSIGN": return "指派";
            case "ACCEPT": return "受理";
            case "PROCESS": return "开始处理";
            case "DONE": return "完成";
            case "CLOSE": return "关闭";
            case "UPLOAD": return "上传附件";
            case "DEL_FILE": return "删除附件";
            case "BIND_ASSET": return "绑定资产";
            case "UNBIND_ASSET": return "解绑资产";
            default: return a ?? "";
        }
    }

    public string AssetStatusText(byte v)
    {
        switch (v)
        {
            case 1: return "在库";
            case 2: return "使用中";
            case 3: return "维修中";
            case 4: return "已报废";
            default: return v.ToString();
        }
    }
}

<link href="~/Content/layui/css/layui.css" rel="stylesheet" />

<div style="padding:15px;">
    <blockquote class="layui-elem-quote layui-text">
        工单详情：@Model.Ticket.Code
    </blockquote>

    <div class="layui-row layui-col-space15">
        <!-- 左侧：信息/操作/评论/附件/关联资产 -->
        <div class="layui-col-md7">

            <!-- 基本信息 -->
            <div class="layui-card">
                <div class="layui-card-header">基本信息</div>
                <div class="layui-card-body">
                    <div><b>标题：</b>@Model.Ticket.Title</div>
                    <div style="margin-top:6px;"><b>状态：</b>@StatusText(Model.Ticket.Status)</div>
                    <div style="margin-top:6px;"><b>优先级：</b>@PriorityText(Model.Ticket.Priority)</div>
                    <div style="margin-top:6px;"><b>分类：</b>@(Model.Category?.Name ?? "未分类")</div>
                    <div style="margin-top:6px;"><b>创建人：</b>@(Model.Creator?.RealName ?? "")</div>
                    <div style="margin-top:6px;"><b>处理人：</b>@(Model.Assignee?.RealName ?? "未指派")</div>

                    <hr />
                    <div><b>描述：</b></div>
                    <div style="white-space:pre-wrap;">@Model.Ticket.Description</div>

                    <hr />

                    <!-- 按状态/权限显示按钮 -->
                    <div>
                        @if (Model.Ticket.Status == 1 && (canOp || isAdmin))
                        {
                            <button class="layui-btn layui-btn-sm" onclick="doAccept()">受理</button>
                        }
                        @if (Model.Ticket.Status == 1 && isAdmin)
                        {
                            <button class="layui-btn layui-btn-sm layui-btn-primary" onclick="openAssign()">指派</button>
                        }

                        @if (Model.Ticket.Status == 2 && (canOp || isAdmin))
                        {
                            <button class="layui-btn layui-btn-sm layui-btn-normal" onclick="doProcess()">开始处理</button>
                            <button class="layui-btn layui-btn-sm layui-btn-danger" onclick="doClose()">关闭</button>
                        }

                        @if (Model.Ticket.Status == 3 && (canOp || isAdmin))
                        {
                            <button class="layui-btn layui-btn-sm layui-btn-warm" onclick="doDone()">完成</button>
                            <button class="layui-btn layui-btn-sm layui-btn-danger" onclick="doClose()">关闭</button>
                        }

                        @if (Model.Ticket.Status == 5 && isAdmin)
                        {
                            <button class="layui-btn layui-btn-sm layui-btn-danger" onclick="doClose()">关闭</button>
                        }

                        @if (!(canOp || isAdmin))
                        {
                            <span class="layui-badge layui-bg-gray">无操作权限（仅处理人/管理员可操作）</span>
                        }
                    </div>
                </div>
            </div>

            <!-- 关联资产 -->
            <div class="layui-card" style="margin-top:10px;">
                <div class="layui-card-header">
                    关联资产
                    @if (isAdmin || canOp)
                    {
                        <button class="layui-btn layui-btn-xs layui-btn-normal" style="margin-left:10px;" onclick="openAssetBind()">关联资产</button>
                    }
                </div>
                <div class="layui-card-body">
                    <table class="layui-table">
                        <thead>
                            <tr>
                                <th style="width:160px;">资产编号</th>
                                <th>名称</th>
                                <th style="width:120px;">类型</th>
                                <th style="width:100px;">状态</th>
                                <th style="width:160px;">操作</th>
                            </tr>
                        </thead>
                        <tbody id="relAssetBody">
                            @if (relAssets != null)
                            {
                                foreach (var a in relAssets)
                                {
                                    <tr>
                                        <td>@a.AssetNo</td>
                                        <td>@a.Name</td>
                                        <td>@a.TypeName</td>
                                        <td>@AssetStatusText((byte)a.Status)</td>
                                        <td>
                                            <a class="layui-btn layui-btn-xs" href="javascript:;" onclick="openAssetDetail(@a.Id)">查看</a>
                                            @if (isAdmin || canOp)
                                            {
                                                <a class="layui-btn layui-btn-danger layui-btn-xs" href="javascript:;" onclick="unbindAsset(@a.Id)">解绑</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="5" style="color:#999;">暂无关联资产</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 附件 -->
            <div class="layui-card" style="margin-top:10px;">
                <div class="layui-card-header">附件</div>
                <div class="layui-card-body">

                    <div style="margin-bottom:10px;">
                        <input type="file" id="fileInput" />
                        <button class="layui-btn layui-btn-sm" onclick="uploadFile()">上传</button>
                    </div>

                    <table class="layui-table">
                        <thead>
                            <tr>
                                <th>文件名</th>
                                <th style="width:120px;">大小</th>
                                <th style="width:180px;">上传时间</th>
                                <th style="width:160px;">操作</th>
                            </tr>
                        </thead>
                        <tbody id="attBody">
                            <tr><td colspan="4" style="color:#999;">加载中...</td></tr>
                        </tbody>
                    </table>

                </div>
            </div>

            <!-- 评论 -->
            <div class="layui-card" style="margin-top:10px;">
                <div class="layui-card-header">评论</div>
                <div class="layui-card-body">
                    <div class="layui-form">
                        <textarea id="comment" placeholder="输入评论..." class="layui-textarea"></textarea>
                        <button class="layui-btn layui-btn-sm" style="margin-top:8px;" onclick="addComment()">提交评论</button>
                    </div>

                    <hr />

                    @if (Model.Comments != null && Model.Comments.Count > 0)
                    {
                        foreach (var c in Model.Comments)
                        {
                            <div style="margin-bottom:10px;">
                                <div class="layui-text" style="color:#666;">
                                    @c.UserName　时间：@c.CreatedAt
                                </div>
                                <div style="white-space:pre-wrap;">@c.Content</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="layui-text" style="color:#999;">暂无评论</div>
                    }
                </div>
            </div>
        </div>

        <!-- 右侧：流转日志 -->
        <div class="layui-col-md5">
            <div class="layui-card">
                <div class="layui-card-header">流转日志</div>
                <div class="layui-card-body" style="max-height:920px;overflow:auto;">
                    <ul class="layui-timeline">
                        @if (Model.FlowLogs != null && Model.FlowLogs.Count > 0)
                        {
                            foreach (var f in Model.FlowLogs)
                            {
                                <li class="layui-timeline-item">
                                    <i class="layui-icon layui-timeline-axis">&#xe63f;</i>
                                    <div class="layui-timeline-content layui-text">
                                        <h3 class="layui-timeline-title">@f.CreatedAt</h3>
                                        <div>动作：@ActionText(f.Action)</div>
                                        <div>状态：@StatusText(f.FromStatus) -> @StatusText(f.ToStatus)</div>
                                        <div>操作人：@f.OperatorName</div>
                                        <div>备注：@f.Remark</div>
                                    </div>
                                </li>
                            }
                        }
                        else
                        {
                            <div class="layui-text" style="color:#999;">暂无流转日志</div>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-3.4.1.js"></script>
<script src="~/Content/layui/layui.js"></script>

<script>
var ticketId = @Model.Ticket.Id;

layui.use(['layer'], function () {
    loadAttachments();
});

function closeMe(){
    var index = parent.layer.getFrameIndex(window.name);
    parent.layer.close(index);
}

function post(url, data, okMsg, closeOnOk) {
    $.post(url, data, function (res) {
        if (res.code === 0) {
            layui.layer.msg(okMsg || '操作成功', { icon: 1, time: 600 }, function () {
                if (closeOnOk) closeMe();
                else location.reload();
            });
        } else {
            layui.layer.msg(res.msg || '操作失败', { icon: 5 });
        }
    }).fail(function () {
        layui.layer.msg('网络错误', { icon: 5 });
    });
}

// ===== 工单流转 =====
function doAccept() { post('/Ticket/Accept', { ticketId: ticketId }, '已受理', true); }
function doProcess() { post('/Ticket/StartProcess', { ticketId: ticketId }, '开始处理', true); }
function doDone() {
    layui.layer.prompt({ title: '完成备注（可选）', formType: 2 }, function (text, index) {
        layui.layer.close(index);
        post('/Ticket/Done', { ticketId: ticketId, remark: text }, '已完成', true);
    });
}
function doClose() {
    layui.layer.prompt({ title: '关闭原因（可选）', formType: 2 }, function (text, index) {
        layui.layer.close(index);
        post('/Ticket/Close', { ticketId: ticketId, remark: text }, '已关闭', true);
    });
}

// ===== 指派（管理员）=====
function openAssign() {
    $.get('/Ticket/UserOptions', function (res) {
        if (res.code !== 0) { layui.layer.msg(res.msg || '加载用户失败', { icon: 5 }); return; }

        var html = '<div style="padding:15px;">'
            + '<select id="assigneeSel" class="layui-select" style="width:100%;height:36px;">';

        res.data.forEach(function (u) {
            html += '<option value="' + u.Id + '">' + u.Name + '</option>';
        });
        html += '</select></div>';

        layui.layer.open({
            type: 1,
            title: '指派处理人',
            area: ['420px', '200px'],
            content: html,
            btn: ['确定', '取消'],
            yes: function () {
                var uid = $('#assigneeSel').val();
                post('/Ticket/Assign', { ticketId: ticketId, assigneeId: uid }, '已指派', true);
            }
        });
    });
}

// ===== 评论 =====
function addComment() {
    var content = $('#comment').val();
    post('/Ticket/AddComment', { ticketId: ticketId, content: content }, '评论已提交', false);
}

// ===== 附件 =====
function loadAttachments() {
    $.get('/Ticket/AttachmentList', { ticketId: ticketId }, function (res) {
        if (res.code !== 0) {
            $('#attBody').html('<tr><td colspan="4" style="color:#999;">' + (res.msg || '无权限或加载失败') + '</td></tr>');
            return;
        }

        var list = res.data || [];
        if (list.length === 0) {
            $('#attBody').html('<tr><td colspan="4" style="color:#999;">暂无附件</td></tr>');
            return;
        }

        var html = '';
        list.forEach(function (a) {
            html += '<tr>'
                + '<td>' + escapeHtml(a.FileName) + '</td>'
                + '<td>' + formatSize(a.FileSize) + '</td>'
                + '<td>' + formatTime(a.CreatedAt) + '</td>'
                + '<td>'
                + '<a class="layui-btn layui-btn-xs" href="/Ticket/DownloadAttachment?id=' + a.Id + '" target="_blank">下载</a> '
                + '<a class="layui-btn layui-btn-danger layui-btn-xs" href="javascript:;" onclick="deleteAttachment(' + a.Id + ')">删除</a>'
                + '</td>'
                + '</tr>';
        });

        $('#attBody').html(html);
    });
}

function uploadFile() {
    var f = $('#fileInput')[0].files[0];
    if (!f) { layui.layer.msg('请选择文件', { icon: 5 }); return; }

    var fd = new FormData();
    fd.append('ticketId', ticketId);
    fd.append('file', f);

    $.ajax({
        url: '/Ticket/UploadAttachment',
        type: 'post',
        data: fd,
        processData: false,
        contentType: false,
        success: function (res) {
            if (res.code === 0) {
                layui.layer.msg('上传成功', { icon: 1, time: 600 }, function () {
                    $('#fileInput').val('');
                    loadAttachments();
                });
            } else {
                layui.layer.msg(res.msg || '上传失败', { icon: 5 });
            }
        },
        error: function () { layui.layer.msg('网络错误', { icon: 5 }); }
    });
}

function deleteAttachment(id) {
    layui.layer.confirm('确定删除该附件吗？', { icon: 3, title: '删除确认' }, function (i) {
        layui.layer.close(i);
        $.post('/Ticket/DeleteAttachment', { id: id }, function (res) {
            if (res.code === 0) {
                layui.layer.msg('已删除', { icon: 1, time: 600 }, function () { loadAttachments(); });
            } else {
                layui.layer.msg(res.msg || '删除失败', { icon: 5 });
            }
        });
    });
}

function formatSize(bytes) {
    if (bytes == null) return '';
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / 1024 / 1024).toFixed(1) + ' MB';
}
function formatTime(v) {
    if (!v) return '';
    if (typeof v === 'string' && v.indexOf('/Date(') === 0) {
        var ms = parseInt(v.replace('/Date(', '').replace(')/', ''));
        var dt = new Date(ms);
        return dt.getFullYear() + '-' + pad(dt.getMonth() + 1) + '-' + pad(dt.getDate())
            + ' ' + pad(dt.getHours()) + ':' + pad(dt.getMinutes());
    }
    return v;
}
function pad(n) { return n < 10 ? '0' + n : n; }

function escapeHtml(s) {
    if (!s) return '';
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

// ===== 关联资产 =====
function openAssetDetail(assetId) {
    layui.layer.open({
        type: 2,
        title: '资产详情',
        content: '/Asset/Detail?id=' + assetId,
        area: ['1000px', '650px']
    });
}

function unbindAsset(assetId) {
    layui.layer.confirm('确定解绑该资产吗？', { icon: 3, title: '解绑确认' }, function (i) {
        layui.layer.close(i);
        $.post('/Ticket/UnbindAsset', { ticketId: ticketId, assetId: assetId }, function (res) {
            if (res.code === 0) {
                layui.layer.msg('已解绑', { icon: 1, time: 600 }, function () { location.reload(); });
            } else {
                layui.layer.msg(res.msg || '解绑失败', { icon: 5 });
            }
        });
    });
}

function openAssetBind() {
    var html = ''
        + '<div style="padding:10px;">'
        + '  <div class="layui-form" style="margin-bottom:8px;">'
        + '    <div class="layui-inline" style="width:260px;">'
        + '      <input type="text" id="assetKey" placeholder="输入资产编号/名称/SN" class="layui-input" />'
        + '    </div>'
        + '    <button class="layui-btn layui-btn-sm" id="btnAssetSearch">搜索</button>'
        + '  </div>'
        + '  <table id="assetSelTable" lay-filter="assetSelTable"></table>'
        + '</div>';

    layui.layer.open({
        type: 1,
        title: '选择资产绑定',
        area: ['900px', '520px'],
        content: html,
        success: function () {
            renderAssetTable('');
            $('#btnAssetSearch').on('click', function () {
                renderAssetTable($('#assetKey').val());
            });
        }
    });
}

function renderAssetTable(keyword) {
    layui.use(['table'], function () {
        var table = layui.table;
        table.render({
            elem: '#assetSelTable',
            url: '/Ticket/AssetSearch',
            method: 'get',
            where: { keyword: keyword },
            page: true,
            limit: 10,
            cols: [[
                { field: 'AssetNo', title: '资产编号', width: 160 },
                { field: 'Name', title: '名称', minWidth: 220 },
                { field: 'TypeName', title: '类型', width: 120 },
                { field: 'SerialNo', title: 'SN', width: 180 },
                { field: 'OwnerName', title: '使用人', width: 120 },
                { field: 'Status', title: '状态', width: 100, templet: function (d) { return assetStatusText(d.Status); } },
                {
                    fixed: 'right', title: '操作', width: 90, templet: function (d) {
                        return '<a class="layui-btn layui-btn-xs" href="javascript:;" onclick="bindAsset(' + d.Id + ')">选择</a>';
                    }
                }
            ]]
        });
    });
}

function assetStatusText(v) {
    switch (v) {
        case 1: return '在库';
        case 2: return '使用中';
        case 3: return '维修中';
        case 4: return '已报废';
        default: return v;
    }
}

function bindAsset(assetId) {
    $.post('/Ticket/BindAsset', { ticketId: ticketId, assetId: assetId }, function (res) {
        if (res.code === 0) {
            layui.layer.msg('绑定成功', { icon: 1, time: 600 }, function () { location.reload(); });
        } else {
            layui.layer.msg(res.msg || '绑定失败', { icon: 5 });
        }
    });
}
</script>